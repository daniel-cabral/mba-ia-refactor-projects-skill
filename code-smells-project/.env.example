# Copy to .env and adjust. All variables are optional; defaults are for local development.
SECRET_KEY=change-me
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=loja.db
# Enables /admin/reset-db and /admin/query (leave 0 outside local development)
ADMIN_ENABLED=0
APP_ENV=desenvolvimento
MAX_CONTENT_LENGTH=1048576
