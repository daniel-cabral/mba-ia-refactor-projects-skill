# Copy to .env and adjust. Every variable is optional in development.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MAX_CONTENT_LENGTH=1048576

# Set to 1 to enable account deletion and to accept role/active from user requests.
ADMIN_ENABLED=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
